# ---- Authorize.net API credentials (use SANDBOX values while testing) ----
# Account > Settings > Security Settings > API Credentials & Keys
ANET_API_LOGIN_ID=
ANET_TRANSACTION_KEY=
# Signature Key (hex). Used to verify webhook signatures. Strongly recommended.
ANET_SIGNATURE_KEY=
# 'sandbox' (apitest.authorize.net) or 'production' (api.authorize.net)
ANET_ENV=sandbox

# ---- This service ----
# Public base URL where THIS service is reachable. The SAME origin must serve
# pay.html and IFrameCommunicator.html. Authorize.net needs to reach the
# communicator URL, so for real testing use an HTTPS tunnel, not localhost.
PUBLIC_BASE_URL=http://localhost:3000

# Merchant name shown on the hosted payment form
MERCHANT_NAME=Methodist University

PORT=3000

# ---- Ellucian EIP / Intelligent Processes ----
# External-task completion endpoint from your Workflow's external task definition.
# Leave blank in sandbox: the service logs the completion instead of calling it.
EIP_TASK_COMPLETE_URL=
EIP_API_TOKEN=
