    {"id": "scholarship_millions", "label": "Scholarships awarded each year ($ millions)", "approved": 24, "pattern": "\\$\\s?(\\d{1,3}(?:\\.\\d)?)\\s?million[^.]{0,30}(?:scholarship|aid)"},
    {"id": "aid_pct", "label": "Share of students receiving institutional aid (%)", "approved": 98, "pattern": "(\\d{2,3})\\s?%\\s+of\\s+(?:our\\s+)?students\\s+receive"},
    {"id": "online_programs", "label": "Fully online degree programs", "approved": 18, "pattern": "(\\d{1,3})\\s+(?:fully\\s+)?online\\s+(?:degree\\s+)?programs"},
    {"id": "enrollment", "label": "Total students", "approved": 1700, "pattern": "(?:university|campus|community|enrollment)\\s+of\\s+(?:about\\s+|approximately\\s+|nearly\\s+|more than\\s+|over\\s+)?([\\d,]{3,6})\\s+students"},
    {"id": "pgm_years", "label": "PGM consecutive years of 100% placement", "approved": 25, "pattern": "(\\d{1,2})\\s+consecutive\\s+years"}
