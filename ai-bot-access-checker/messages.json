{
  "_about": "Editable. Pre-filled from MU_Brand_Positioning_Statements. Patterns are case-insensitive regular expressions. Restart the app after editing. Numeric claims skip news and dated pages (historical figures are expected there).",
  "priority_pages": [
    "https://www.methodist.edu/",
    "https://www.methodist.edu/admissions-aid/",
    "https://www.methodist.edu/admissions-aid/apply/",
    "https://www.methodist.edu/admissions-aid/undergraduate/first-year-students/",
    "https://www.methodist.edu/admissions-aid/undergraduate/transfer/",
    "https://www.methodist.edu/admissions-aid/financial-aid/",
    "https://www.methodist.edu/admissions-aid/military/",
    "https://www.methodist.edu/admissions-aid/graduate/",
    "https://www.methodist.edu/academics/medicine/",
    "https://www.methodist.edu/explore-mu/value/",
    "https://www.methodist.edu/explore-mu/on-a-tour/",
    "https://www.methodist.edu/explore-mu/numbers/",
    "https://www.methodist.edu/academics/program/nursing/",
    "https://www.methodist.edu/academics/program/pgm/",
    "https://www.methodist.edu/academics/program/engineering/",
    "https://www.methodist.edu/academics/program/paprogram/",
    "https://www.methodist.edu/academics/program/dpt/",
    "https://www.methodist.edu/academics/program/otd/",
    "https://www.methodist.edu/academics/program/clinical-mental-health-counseling/",
    "https://www.methodist.edu/academics/program/psychology/"
  ],
  "connections": {
    "School of Medicine": "/academics/medicine/",
    "Admissions": "/admissions-aid/(apply|undergraduate|graduate|request)|/academics/medicine/admissions",
    "Scholarships and aid": "financial-aid|scholarship|/aid/|tuition|cost",
    "Outcomes and careers": "outcome|career|placement|numbers"
  },
  "connections_required": 2,
  "proof_points": [
    {
      "id": "medical_school",
      "label": "School of Medicine (opened 2026, with Cape Fear Valley Health)",
      "pattern": "school of medicine|medical school"
    },
    {
      "id": "smallest_med",
      "label": "Smallest university in America with a medical school",
      "pattern": "smallest university[^.]{0,60}medical school"
    },
    {
      "id": "carnegie",
      "label": "Carnegie: Professions-focused Undergraduate/Graduate-Doctorate Small",
      "pattern": "professions[- ]focused|carnegie classification"
    },
    {
      "id": "monarch_momentum",
      "label": "Monarch Momentum pathways (guaranteed interview, 5 graduate health programs)",
      "pattern": "monarch momentum"
    },
    {
      "id": "scholarships",
      "label": "$24 million in scholarships each year",
      "pattern": "\\$\\s?24 million"
    },
    {
      "id": "aid_98",
      "label": "98% of students receive institutional aid",
      "pattern": "98\\s?%\\s+of\\s+(our\\s+)?students"
    },
    {
      "id": "ncaa",
      "label": "20 NCAA Division III teams",
      "pattern": "20 ncaa|division iii|div\\.? iii"
    },
    {
      "id": "military",
      "label": "Military Gold / Best for Vets; 18 online programs",
      "pattern": "military gold|military friendly|best for vets"
    },
    {
      "id": "nursing_pass",
      "label": "Nursing: 100% board pass rate (2025)",
      "pattern": "100\\s?%[^.]{0,40}(board|nclex|pass)"
    },
    {
      "id": "pgm_placement",
      "label": "PGM: 25 consecutive years of 100% job placement",
      "pattern": "25 consecutive years|100\\s?%[^.]{0,30}placement"
    },
    {
      "id": "abet",
      "label": "ABET-accredited engineering",
      "pattern": "\\babet\\b"
    },
    {
      "id": "faculty_know",
      "label": "Faculty who know every student",
      "pattern": "know (every|each) student|knows? (you|me|everyone) by name|everybody knows me"
    },
    {
      "id": "purpose",
      "label": "Know How. Know Why. / Life on Purpose / Veritas et Virtus",
      "pattern": "know how\\.? know why|life on purpose|veritas et virtus|purpose meets profession"
    }
  ],
  "proof_points_required_on_priority_page": 1,
  "banned_phrases": [
    {
      "phrase": "best kept secret",
      "pattern": "best[- ]kept secret"
    },
    {
      "phrase": "little engine that could",
      "pattern": "little engine that could"
    },
    {
      "phrase": "liberal arts (school/college/university)",
      "pattern": "liberal arts (school|college|university|institution)"
    }
  ],
  "numeric_claims": [
    {
      "id": "clubs",
      "label": "Student clubs and organizations",
      "approved": 90,
      "pattern": "(\\d{2,3})\\+?\\s+(?:student\\s+)?(?:clubs|organizations)"
    },
    {
      "id": "ncaa_teams",
      "label": "NCAA teams/sports",
      "approved": 20,
      "pattern": "\\b(\\d{1,2})\\s+NCAA\\s+(?:Division\\s+III\\s+|D-?III\\s+)?(?:intercollegiate\\s+)?(?:sports|teams|athletic|varsity)"
    },
    {
      "id": "scholarship_millions",
      "label": "Scholarships awarded each year ($ millions)",
      "approved": 24,
      "pattern": "\\$\\s?(\\d{1,3}(?:\\.\\d)?)\\s?million[^.]{0,30}(?:scholarships?|institutional aid)\\b[^.]{0,20}\\b(?:each|every|per|a|annually)\\b"
    },
    {
      "id": "aid_pct",
      "label": "Share of students receiving institutional aid (%)",
      "approved": 98,
      "pattern": "(\\d{2,3})\\s?%\\s+of\\s+(?:our\\s+)?students\\s+receive"
    },
    {
      "id": "online_programs",
      "label": "Fully online degree programs",
      "approved": 18,
      "pattern": "\\b(\\d{1,3})\\s+(?:fully\\s+)?online\\s+(?:degree\\s+)?programs"
    },
    {
      "id": "enrollment",
      "label": "Total students",
      "approved": 1700,
      "pattern": "(?<!record )(?:university|campus|community|enrollment)\\s+of\\s+(?:about\\s+|approximately\\s+|nearly\\s+|more than\\s+|over\\s+)?([\\d,]{3,6})\\s+students"
    },
    {
      "id": "pgm_years",
      "label": "PGM consecutive years of 100% placement",
      "approved": 25,
      "pattern": "(\\d{1,2})\\s+consecutive\\s+years"
    }
  ],
  "inventory": {
    "net_price_calculator": {
      "label": "Net price calculator linked",
      "pattern": "net price calculator|npc\\.|/npc"
    },
    "cost_page": {
      "label": "Tuition / cost of attendance page",
      "pattern": "cost of attendance|tuition (and|&) fees|tuition-fees|/cost"
    },
    "virtual_tour": {
      "label": "Virtual tour linked",
      "pattern": "virtual tour|360|youvisit|concept3d|campus tour"
    },
    "parents_page": {
      "label": "Page for parents and families",
      "pattern": "/parents"
    },
    "tiktok": {
      "label": "TikTok linked",
      "pattern": "tiktok\\.com"
    },
    "instagram": {
      "label": "Instagram linked",
      "pattern": "instagram\\.com"
    },
    "youtube": {
      "label": "YouTube linked",
      "pattern": "youtube\\.com"
    }
  },
  "virtual_tour_sections": [
    "/admissions-aid/",
    "/academics/",
    "/life-at-mu/",
    "/life-at-mu/housing-residence-life/",
    "/explore-mu/on-a-tour/"
  ],
  "outcome_pattern": "placement|employed|employment rate|job rate|pass rate|board pass|nclex|salary|graduate school acceptance|career outcomes|alumni work at",
  "outdated_phrases": [
    {
      "id": "som_applicant",
      "phrase": "LCME \"applicant\" or \"candidate\" status",
      "use_instead": "Preliminary LCME accreditation (October 2025)",
      "pattern": "(applicant|candidate|candidacy) (program|school|status|designation)[^.]{0,150}(LCME|Liaison Committee)|(LCME|Liaison Committee)[^.]{0,150}(applicant|candidate|candidacy) (program|school|status|designation)"
    },
    {
      "id": "som_future",
      "phrase": "School of Medicine described as not yet open or pending approval",
      "use_instead": "Opened July 20, 2026, with 64 students",
      "pattern": "(School of Medicine|medical school|College of Medicine)[^.]{0,120}(will (open|welcome|enroll|begin|launch)|plans? to (open|enroll)|(expected|anticipated|scheduled) to (open|begin|enroll)|pending (LCME|SACSCOC|accreditation|approval))|pending (LCME|SACSCOC) (approval|accreditation)"
    },
    {
      "id": "som_old_name",
      "phrase": "\"MU College of Medicine\"",
      "use_instead": "Methodist University Cape Fear Valley Health School of Medicine",
      "pattern": "(MU|Methodist University) College of Medicine|College of Medicine at Methodist"
    },
    {
      "id": "fort_liberty",
      "phrase": "\"Fort Liberty\"",
      "use_instead": "Fort Bragg (renamed back Feb. 14, 2025)",
      "pattern": "(?<!formerly )(?<!previously )(?<!once )(?<!renamed from )Fort Liberty(?! \\((formerly|previously|now|renamed))"
    },
    {
      "id": "pope_afb",
      "phrase": "\"Pope Air Force Base\"",
      "use_instead": "Pope Army Airfield (since 2011)",
      "pattern": "Pope (Air Force Base|AFB)\\b"
    },
    {
      "id": "twitter",
      "phrase": "\"Twitter\"",
      "use_instead": "X",
      "pattern": "\\bTwitter\\b(?! \\(now X\\))"
    },
    {
      "id": "covid_ops",
      "phrase": "COVID-era operating notices",
      "use_instead": "Remove, or label as historical",
      "pattern": "(COVID|coronavirus|pandemic)[^.]{0,100}(protocols? (are|remain|require)|masks? (are|is) (required|optional)|social distancing|until further notice|remote instruction|virtual only|test-optional for (fall|spring) 202[0-3])"
    },
    {
      "id": "old_copyright",
      "phrase": "Old copyright year",
      "use_instead": "Current year (set the footer to update automatically)",
      "pattern": "(©|Copyright)\\s*(?:20\\d\\d\\s*[-–]\\s*)?({OLD_YEARS})\\b"
    }
  ],
  "manual_actions": [
    {
      "title": "Point the old School of Medicine URL to the School of Medicine page",
      "priority": "high",
      "why": "/academics/medicine-2/ now redirects to an image file (/wp-content/uploads/2023/05/medicine.jpg). Search results still show its old \"applicant program\" text, and anyone who clicks lands on a picture instead of the medical school.",
      "fix": "Change the redirect so /academics/medicine-2/ goes (301) to the current School of Medicine page, not the image. Then use URL Inspection in Google Search Console to request a recrawl.",
      "owner": "Web team",
      "scope": "1 page"
    },
    {
      "title": "Add update notes to older School of Medicine news posts",
      "priority": "high",
      "why": "Posts from before October 2025 describe applicant or candidate status. AI quotes them as current.",
      "fix": "Add one line at the top of each: \"Update: The School of Medicine received preliminary LCME accreditation in October 2025 and opened in July 2026.\" Do not rewrite the posts. Start with: Hershey Bell founding dean, $8 million Golden LEAF, Nichols IAMSE, nursing partnership, LCME candidacy designation.",
      "owner": "Marketing",
      "scope": "5+ posts"
    },
    {
      "title": "Publish School of Medicine admissions facts",
      "priority": "high",
      "why": "No official tuition, MCAT/GPA expectations or in-state policy is published. The only tuition figure online is a third-party $70,500. AI guesses.",
      "fix": "Publish 2026-27 tuition, MCAT/GPA expectations (or state none), NC-resident policy and the 2027 AMCAS deadline as page text on the SOM admissions FAQ.",
      "owner": "School of Medicine + Web team",
      "scope": "SOM admissions FAQ"
    },
    {
      "title": "Approve the facts in the accuracy spreadsheet",
      "priority": "normal",
      "why": "AI answers can only be scored for accuracy against approved facts. 38 facts are waiting.",
      "fix": "Fill the yellow columns in MU-AI-Accuracy-Facts.xlsx (one figure per fact, official source, approver, date) and return it.",
      "owner": "Institutional Research + Marketing",
      "scope": "38 facts"
    },
    {
      "title": "Use one School of Medicine building cost",
      "priority": "normal",
      "why": "News coverage reports both $60 million and $65 million.",
      "fix": "Confirm the figure and correct MU pages and press materials that use the other one.",
      "owner": "Marketing",
      "scope": "News and SOM pages"
    }
  ],
  "findability": {
    "_about": "Findability check: topics a student looks for, starting from a section page. 'page' finds a page about the topic (title, headings or address). 'fact' is the statement that answers it (must be in the page's own text, not menus or footer). Case-insensitive regular expressions.",
    "max_clicks": 3,
    "max_pages": 300,
    "sets": {
      "medicine": {
        "label": "School of Medicine",
        "start": "https://www.methodist.edu/academics/medicine/",
        "section": "/academics/medicine/",
        "topics": [
          {
            "id": "cost",
            "label": "Tuition and cost of attendance",
            "page": "tuition|cost of attendance|\\bcost\\b",
            "fact": "(tuition|cost of attendance)[^.\\n]{0,120}\\$\\s?\\d{1,3}(,\\d{3})+|\\$\\s?\\d{1,3}(,\\d{3})+[^.\\n]{0,60}(tuition|cost of attendance)",
            "not_near": "remission|scholarship|award|grant"
          },
          {
            "id": "aid",
            "label": "Financial aid and scholarships",
            "page": "financial aid|scholarships?|\\baid\\b",
            "fact": "FAFSA|federal (direct )?(unsubsidized )?loans?|Grad(uate)? PLUS|scholarships? (are|is) (available|awarded|offered)|scholarships?[^.\\n]{0,80}\\$\\s?\\d"
          },
          {
            "id": "deadline",
            "label": "Application deadline",
            "page": "apply|application|admissions",
            "fact": "(deadline|due|accept(s|ing)? applications|AMCAS|secondary application)[^.\\n]{0,100}(January|February|March|April|May|June|July|August|September|October|November|December|Jan\\.?|Feb\\.?|Aug\\.?|Sept?\\.?|Oct\\.?|Nov\\.?|Dec\\.?) \\d{1,2}|(January|February|March|April|May|June|July|August|September|October|November|December|Jan\\.?|Feb\\.?|Aug\\.?|Sept?\\.?|Oct\\.?|Nov\\.?|Dec\\.?) \\d{1,2}[^.\\n]{0,60}(deadline|due)"
          },
          {
            "id": "mcat_gpa",
            "label": "MCAT and GPA expectations",
            "page": "MCAT|GPA|requirements|prerequisites",
            "fact": "MCAT[^.\\n]{0,80}\\b(4[89]\\d|5[0-2]\\d)\\b|\\b(4[89]\\d|5[0-2]\\d)\\b[^.\\n]{0,40}MCAT|GPA[^.\\n]{0,60}\\b[234]\\.\\d|\\b[234]\\.\\d{1,2}\\b[^.\\n]{0,40}GPA"
          },
          {
            "id": "monarch_momentum",
            "label": "Early pathway for MU undergraduates (Monarch Momentum)",
            "page": "Monarch Momentum|early assurance",
            "fact": "Monarch Momentum"
          },
          {
            "id": "accreditation",
            "label": "Accreditation status",
            "page": "accredit",
            "fact": "(LCME|Liaison Committee on Medical Education|COCA)[^.\\n]{0,160}(accredit|preliminary|provisional|candidate)|(accredit|preliminary|provisional)[^.\\n]{0,160}(LCME|Liaison Committee on Medical Education|COCA)"
          },
          {
            "id": "class_size",
            "label": "Class size",
            "page": "class size|class profile|how many students|FAQ",
            "fact": "\\b\\d{2,3} (students|seats|matriculants|medical students)\\b|class (size|of \\d{4})[^.\\n]{0,60}\\b\\d{2,3}\\b"
          },
          {
            "id": "outcomes",
            "label": "Outcomes: residency match and placement",
            "page": "outcomes?|residenc(y|ies)\\b|\\bmatch\\b",
            "fact": "match (rate|list|results)|residenc(y|ies)\\b[^.\\n]{0,100}(\\d+%|match(ed)?|placement)|\\d+%[^.\\n]{0,60}(match|residenc(y|ies)\\b)"
          }
        ],
        "context": "School of Medicine|medical school|medical education|\\bM\\.?D\\.?\\b|LCME|AMCAS|MCAT|medical students?",
        "skip_pages": "/(directory|news|events?)/"
      }
    }
  }
}
