    {"phrase": "best kept secret", "pattern": "best[- ]kept secret"},
    {"phrase": "little engine that could", "pattern": "little engine that could"},
    {"phrase": "liberal arts (school/college/university)", "pattern": "liberal arts (school|college|university|institution)"}
