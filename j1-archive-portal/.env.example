# Copy to .env and fill in real values — never commit .env

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# MSSQL — use the read-only login created by archive/Set-J1ArchiveAccess.sql
MSSQL_SERVER=j1archive.methodist.edu
MSSQL_DATABASE=J1_Archive
MSSQL_USER=j1_archive_reader
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
